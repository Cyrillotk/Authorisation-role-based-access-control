<!DOCTYPE html>
<html>
<head>
  <title>Edit Post</title>
</head>
<body>

  <h1>Edit Post</h1>

  <form
    action="/posts/<%= post._id %>/update"
    method="POST"
  >

    <input
      type="text"
      name="title"
      value="<%= post.title %>"
      required
    >

    <textarea
      name="content"
      required
    ><%= post.content %></textarea>

    <select name="category" required>

      <option
        value="technology"
        <%= post.category === 'technology' ? 'selected' : '' %>
      >
        Technology
      </option>

      <option
        value="business"
        <%= post.category === 'business' ? 'selected' : '' %>
      >
        Business
      </option>

      <option
        value="education"
        <%= post.category === 'education' ? 'selected' : '' %>
      >
        Education
      </option>

    </select>

    <button type="submit">Update Post</button>

  </form>

</body>
</html>